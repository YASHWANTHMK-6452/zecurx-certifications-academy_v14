# Razorpay (Dashboard -> Account & Settings -> API Keys). Use rk_test keys while testing.
# Set these in Vercel -> Project -> Settings -> Environment Variables (and in .env.local for `vercel dev`).
# The secret is used only by the /api functions and must never be committed or exposed to the browser.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Webhook secret: Razorpay Dashboard -> Settings -> Webhooks -> Add new webhook.
# URL: https://YOUR-DOMAIN/api/razorpay-webhook   Events: order.paid, payment.captured, payment.failed
# Choose any strong random string as the secret and paste the same value here.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Storage for enrollments, certificates and verified reviews.
# Vercel -> Storage -> add "Upstash Redis" (sets these automatically), or create a free database at upstash.com.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Secret for the admin endpoints that issue certificates. Use 24+ random characters. Never expose it in the browser.
ADMIN_API_KEY=change-me-to-a-long-random-string

# Optional discount coupons (JSON). type is "percent" or "flat" (rupees); courses and expires (YYYY-MM-DD) are optional.
# Validated on the server, so customers cannot change the discount in the browser.
COUPONS={"WELCOME10":{"type":"percent","value":10},"FLAT2000":{"type":"flat","value":2000,"courses":["zxCPEH"],"expires":"2026-12-31"}}

# Review approval emails via SendGrid. New reviews are held until approved from the email.
# SendGrid -> Settings -> API Keys -> Create API Key (Restricted Access, enable "Mail Send").
SENDGRID_API_KEY=SG.xxxxxxxxxxxx
# Inbox that receives the approve/reject emails.
REVIEW_NOTIFY_EMAIL=you@example.com
# Must be a sender verified in SendGrid (Settings -> Sender Authentication), e.g. "ZecurX Reviews <reviews@yourdomain.com>".
REVIEW_FROM_EMAIL=reviews@yourdomain.com
# Optional: your public site URL used in the approval links, e.g. https://yourdomain.com. Defaults to the request host.
SITE_URL=

# --- PostgreSQL storage (optional; used instead of Upstash when DATABASE_URL is set) ---
# Use a dedicated limited user, e.g. postgresql://zecurx_app:PASSWORD@db.yourdomain.com:5432/zecurx_academy
# Do not add ?sslmode=... to the URL. SSL is controlled below.
DATABASE_URL=
# "off" disables SSL (not recommended). Leave empty for encrypted connections.
DATABASE_SSL=
# Optional: your server's certificate (PEM, newlines as \n) to also verify the server's identity.
DATABASE_CA=
